# PostgreSQL — Railway provides DATABASE_URL automatically
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Puerto del servidor
PORT=3000

# CORS — URL de tu frontend en GitHub Pages
FRONTEND_URL=https://marcosboli.github.io

# Email SMTP (puedes usar Gmail, Brevo, Resend, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password

# Email del restaurante (donde llegan las notificaciones de reserva)
RESTAURANT_EMAIL=reservas@bodegasmonasterio.es
RESTAURANT_NAME=Bodegas Monasterio
